# ─── API GENDO (herdado do projeto base) ──────────────────────────────────────
API_BASE_URL=https://seusubdominio.adm.gendo.app/api
API_TOKEN=seu_token_aqui
API_TIMEOUT=30

# ─── GOOGLE SHEETS (herdado do projeto base) ──────────────────────────────────
# Defina UMA das duas opções:
GOOGLE_CREDENTIALS_FILE=../google_credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
GOOGLE_SHEETS_ID=seu_id_de_planilha_aqui

# ─── WHATSAPP Business Cloud API (via Gupshup) ────────────────────────────────
WHATSAPP_API_TOKEN=sk_...
WHATSAPP_WABA_ID=1234567890123456
WHATSAPP_SOURCE_NUMBER=5511940000000
WHATSAPP_APP_NAME=nome-do-app-no-gupshup
WHATSAPP_SDR_NUMBER=5511999999999
WHATSAPP_TEMPLATE_NAME=nome_do_template_aprovado_meta
WHATSAPP_TEMPLATE_ID=uuid_do_template_no_gupshup

# ─── LLM (failover bidirecional: primário atende, backup assume se esgotar) ────
LLM_PRIMARY=nvidia                       # "nvidia" ou "groq"
NVIDIA_API_KEY=sua_chave_nvidia_aqui     # NVIDIA NIM (integrate.api.nvidia.com)
GROQ_API_KEY=sua_chave_groq_aqui         # Groq (api.groq.com) — backup
# Opcionais (têm default no config.py):
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# GROQ_MODEL=llama-3.3-70b-versatile

# ─── CONFIGURAÇÃO DE VISITAS ──────────────────────────────────────────────────
VISITA_DURACAO_MINUTOS=60
SLOT_INICIO=09:00
SLOT_FIM=16:30

# ─── MODO TESTE ───────────────────────────────────────────────────────────────
MODO_TESTE=true
WHATSAPP_TESTE_NUMBER=5511989171391
