[Unit]
Description=Agente Reagendamento WhatsApp — servidor de webhook
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/relatorio-visitas/agente_reagendamento
EnvironmentFile=/opt/relatorio-visitas/agente_reagendamento/.env
ExecStart=/opt/relatorio-visitas/.venv/bin/uvicorn server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
