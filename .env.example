# ─── API Gendo ─────────────────────────────────────────────────────────────────
API_BASE_URL=https://seusubdominio.adm.gendo.app/api
API_TOKEN=seu_token_aqui
API_TIMEOUT=30

# ─── PERÍODO (relatorio_visitas.py) ────────────────────────────────────────────
# Deixe em branco para usar o último dia útil automaticamente.
DATA_INICIO=
DATA_FIM=

# ─── GOOGLE CREDENTIALS ────────────────────────────────────────────────────────
# Opção 1 — arquivo JSON local (VPS)
GOOGLE_CREDENTIALS_FILE=./google_credentials.json
# Opção 2 — JSON como string (CI/CD / GitHub Actions Secrets)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ─── GOOGLE SHEETS ─────────────────────────────────────────────────────────────
GOOGLE_SHEETS_ID=seu_id_de_planilha_aqui

# ─── Z-API (WhatsApp) ──────────────────────────────────────────────────────────
# Painel: app.z-api.io → sua instância
ZAPI_INSTANCE_ID=sua_instance_id
ZAPI_TOKEN=seu_token_zapi
ZAPI_CLIENT_TOKEN=seu_client_token
# Número do SDR para notificações (com DDI, sem +): ex 5511999990000
WHATSAPP_SDR_NUMBER=5511999990000

# ─── LLM (Groq) ────────────────────────────────────────────────────────────────
# Obtenha em: console.groq.com
GROQ_API_KEY=gsk_...

# ─── AGENTE REAGENDAMENTO ──────────────────────────────────────────────────────
SLOT_INICIO=09:00
SLOT_FIM=16:30
VISITA_DURACAO_MINUTOS=60
# Override de data para forçar aba específica (dd/mm/yyyy) — útil em testes
DATA_OVERRIDE=

# ─── MODO TESTE ────────────────────────────────────────────────────────────────
# true → só processa o número abaixo, ignora todos os leads reais
MODO_TESTE=false
WHATSAPP_TESTE_NUMBER=5511999990000
